# Database (host port 5435 → container 5432)
DATABASE_URL=postgresql://kernle:kernle@localhost:5435/kernle?schema=public

# Redis (host port 6381 → container 6379)
REDIS_URL=redis://localhost:6381

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
APP_URL=http://localhost:3101
API_URL=http://localhost:3100
WEB_ORIGIN=http://localhost:3101

# Tenant
ROOT_DOMAIN=localhost
COOKIE_DOMAIN=localhost

# Object storage (Phase 3+) — host ports 9010/9011
S3_ENDPOINT=http://localhost:9010
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=kernle-assets
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9010/kernle-assets
STORAGE_PATH=./tmp/kernle-assets

# AI (Phase 6+)
ANTHROPIC_API_KEY=
AI_MOCK=true

# Stripe (Phase 7+)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Observability (Phase 7+)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Super-admin
SUPER_ADMIN_EMAILS=admin@kernle.local,owner@kernle.local

# Web
NEXT_PUBLIC_API_URL=http://localhost:3100/api
